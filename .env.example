# ──────────────────────────────────────────────────────────────
# Industrial Knowledge Intelligence Platform — Environment Config
# Copy this file to `.env` and fill in the values.
# ──────────────────────────────────────────────────────────────

# ── LLM: Ollama cloud models (FREE — inference runs on Ollama's servers) ──
# Default: route through the LOCAL Ollama daemon, which proxies `*-cloud`
# models to the cloud. No GPU and no API key required in this app — just
# have Ollama running and signed in (`ollama signin`), then:
#   ollama pull gpt-oss:20b-cloud
#   ollama pull gpt-oss:120b-cloud
OLLAMA_API_KEY=ollama                          # any non-empty value for local proxy
OLLAMA_BASE_URL=http://localhost:11434/v1      # local Ollama OpenAI-compatible endpoint
LLM_MODEL_FAST=gpt-oss:20b-cloud               # bulk: entity extraction, classification, summaries
LLM_MODEL_SMART=gpt-oss:120b-cloud             # reasoning: copilot, RCA, compliance, lessons
#
# Alternative — call ollama.com directly (needs a real key from ollama.com → Settings → Keys):
#   OLLAMA_BASE_URL=https://ollama.com/v1
#   OLLAMA_API_KEY=<your-key>
#   LLM_MODEL_FAST=gpt-oss:20b      (no -cloud suffix)
#   LLM_MODEL_SMART=gpt-oss:120b

# ── Embeddings (local, no API cost) ──
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── PostgreSQL ──
POSTGRES_USER=ikb
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=industrial_kb
# Host-run backend uses localhost; Docker backend overrides to service name.
POSTGRES_URL=postgresql+asyncpg://ikb:change_me_postgres@localhost:55432/industrial_kb

# ── Neo4j ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j

# ── Qdrant (vector store) ──
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=industrial_chunks

# ── MinIO (S3-compatible file storage) ──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio
MINIO_BUCKET=industrial-docs
MINIO_SECURE=false

# ── App ──
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=100